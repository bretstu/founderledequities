[Unit]
Description=Founder Led Equities nightly rebuild and deploy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --- edit these three paths/values for the mini PC ---
User=bretstu
WorkingDirectory=/home/bretstu/projects/founderledequities
# The EDGAR user agent lives in .env (FLE_USER_AGENT="Name email"), which
# the pipeline reads on start. Do NOT set it here: systemd splits an unquoted
# value on spaces, the contact address is dropped, and EDGAR answers 403 to
# every request -- which is how the night of 2026-09-03 was lost.
# a real contact address in the user agent is what keeps EDGAR from 403ing you
Environment=FLE_DEPLOY_CMD=/home/bretstu/projects/founderledequities/ops/deploy.sh
# optional: a healthchecks.io (or similar) ping URL; pages you when a night fails
#Environment=FLE_HEARTBEAT_URL=https://hc-ping.com/your-uuid-here
ExecStart=/usr/bin/python3 -m fle.cli refresh --dir /home/bretstu/projects/founderledequities
# refuse-to-publish (exit 2) and failures both count as failed for monitoring
SuccessExitStatus=0
TimeoutStartSec=4h
