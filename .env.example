# Copy this file to ".env" and fill in your values.
# Do not commit .env or share it -- the API key is a credential.

# Required by the SEC's fair-access policy. Must be a real contact address;
# requests without one are rejected with a 403.
OWNERSHIP_UA=Your Name your@email.com

# Used only by extract.py, to read the ownership-table footnotes.
# Get one at https://console.anthropic.com  (separate from a Claude.ai plan).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# OWNERSHIP_MODEL=claude-sonnet-5
# OWNERSHIP_CACHE=.cache
