# SEC fair access requires a User-Agent that names a real caller and contact.
# Without one EDGAR returns 403s that are easy to mistake for rate limiting.
FLE_USER_AGENT=FounderLedEquities research you@example.com

# Where fetched documents are cached. Filings never change, so this can live
# a long time.
FLE_CACHE=.cache

# Only needed once prices are added back.
POLYGON_API_KEY=
